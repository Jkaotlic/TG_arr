# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Allowed Telegram User IDs (comma-separated)
# Get your ID from @userinfobot or @raw_data_bot
ALLOWED_TG_IDS=123456789,987654321

# Admin User IDs (comma-separated, optional)
ADMIN_TG_IDS=123456789

# ---------------------------------------------------------------------------
# Movies, series and anime — Radarr, Sonarr and Prowlarr (all required)
#
# Rolled back to *arr on 2026-08-10. Radarr and Sonarr own the catalog, the
# quality profiles and the custom formats that implement the language policy;
# their interactive search returns releases they have already judged, and the
# bot defers to that verdict rather than re-deriving it.
#
# Anime is NOT a separate service: it is Sonarr's `seriesType=anime`, in the
# same root folders as ordinary series.
# ---------------------------------------------------------------------------
# Radarr — movies (/api/v3)
RADARR_URL=http://radarr:7878
RADARR_API_KEY=your_radarr_api_key

# Sonarr — series and anime (/api/v3)
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=your_sonarr_api_key

# Quality profile for users who have not picked one in /settings (optional).
# Unset: a profile named like 4K/2160, else the first one (/settings warns).
# RADARR_DEFAULT_PROFILE_ID=7
# SONARR_DEFAULT_PROFILE_ID=7

# Prowlarr — free-text release search for titles not yet in the catalog.
# NOTE: Prowlarr's API is /api/v1, unlike Radarr's and Sonarr's /api/v3.
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=your_prowlarr_api_key
# A search fans out to every configured indexer. RuTracker sits behind
# Cloudflare and answers 521/522 under load, so 25s timed out routinely in
# production — hence 45s and one automatic retry.
# PROWLARR_SEARCH_TIMEOUT=45.0
# PROWLARR_SEARCH_RETRIES=1

# ---------------------------------------------------------------------------
# Music
# ---------------------------------------------------------------------------
# Lidarr (optional) — artist/album monitoring; hands downloads to slskd.
# Lidarr answers on /api/v1, not /api/v3 — a v3 probe reports "API DOWN"
# against a perfectly healthy Lidarr.
# LIDARR_URL=http://lidarr:8686
# LIDARR_API_KEY=your_lidarr_api_key

# slskd / Soulseek (optional) — direct album & track search, and the download
# client Lidarr itself uses. Enables /music album+track search without Lidarr.
# SLSKD_URL=http://slskd:5030
# SLSKD_API_KEY=your_slskd_api_key
# SLSKD_TIMEOUT=30.0
# SLSKD_SEARCH_TIMEOUT=25.0   # how long to gather Soulseek responses

# Navidrome (optional) — read-only "already in the library" check so the bot
# doesn't queue duplicates. All three values are required to enable it.
# NAVIDROME_URL=http://navidrome:4533
# NAVIDROME_USERNAME=your_navidrome_user
# NAVIDROME_PASSWORD=your_navidrome_password
# NAVIDROME_TIMEOUT=15.0

# Deezer public API (for music trending, no key required)
# DEEZER_ENABLED=true

# ---------------------------------------------------------------------------
# Download client & media server
# ---------------------------------------------------------------------------
# qBittorrent (optional) — download status and the «force download» button, the
# escape hatch for a release the user wants despite the quality profile. It is
# never an automatic fallback: when *arr refuses a release, the user decides.
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=your_qbittorrent_password
# QBITTORRENT_TIMEOUT=30.0

# Emby (optional) — "already in library" hint on release cards
EMBY_URL=http://emby:8096
EMBY_API_KEY=your_emby_api_key
# EMBY_TIMEOUT=30.0
# Address the «▶️ Смотреть в Emby» button opens (what your phone/TV can reach,
# e.g. https://emby.example.com). Empty → EMBY_URL.
# EMBY_PUBLIC_URL=

# TMDb Configuration (optional, for trending/popular content)
# Get your API key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key
# TMDB_LANGUAGE=ru-RU  # Language for TMDb content (ru-RU, en-US, etc.)
# TMDB_PROXY_URL=http://your-vps:8899  # HTTP proxy for TMDb (if geo-blocked)

# Download Notifications
NOTIFY_DOWNLOAD_COMPLETE=true
NOTIFY_CHECK_INTERVAL=60
# Music (slskd): one summary per album once it has been quiet this long (sec);
# an album with tracks still queued gets a partial summary after the stall time.
# MUSIC_NOTIFY_SETTLE_SECONDS=300
# MUSIC_NOTIFY_STALL_SECONDS=3600
# qBittorrent categories imported by Radarr/Sonarr: no "download finished"
# message for them, the «в библиотеке» notice covers it.
# ARR_TORRENT_CATEGORIES=radarr,tv-sonarr,sonarr
# Send admins a "bot is up" card on startup (which backends answered, versions)
# NOTIFY_ADMINS_ON_START=true

# TorrServer (streaming contour — "watch now")
# TORRSERVER_URL=http://198.51.100.10:8090
# TORRSERVER_USERNAME=admin
# TORRSERVER_PASSWORD=
# TORRSERVER_TIMEOUT=30.0
# TORRSERVER_SEARCH_TIMEOUT=60.0
# TORRSERVER_METADATA_TIMEOUT=30.0

# Emby sync hook on Homeserver (forced .strm sync right after adding a torrent)
# EMBY_SYNC_HOOK_URL=http://198.51.100.10:8099
# EMBY_SYNC_HOOK_TOKEN=
# EMBY_SYNC_HOOK_TIMEOUT=90.0

# Optional Settings
TIMEZONE=Europe/Moscow
# Morning digest «🌅 Сводка за сутки»: local hour (TIMEZONE above). Each user
# can switch it off in /settings. Empty → 9.
# DIGEST_HOUR=9
LOG_LEVEL=INFO
# LOG_FORMAT=json  # "json" for docker logs (default) or "console" for local dev

# Database path (relative to /app in container)
DATABASE_PATH=data/bot.db

# Scoring thresholds
AUTO_GRAB_SCORE_THRESHOLD=80

# HTTP client settings
# HTTP_TIMEOUT=30.0  # HTTP request timeout in seconds. Slow *arr calls (lookup, history,
#                     grabbing a release) use 90 s, or this value if it is larger

# Pagination
# RESULTS_PER_PAGE=5  # Search results per page (1-10)


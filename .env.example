# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Allowed Telegram User IDs (comma-separated)
# Get your ID from @userinfobot or @raw_data_bot
ALLOWED_TG_IDS=123456789,987654321

# Admin User IDs (comma-separated, optional)
ADMIN_TG_IDS=123456789

# ---------------------------------------------------------------------------
# Scryer — movies, series and anime (required)
#
# Scryer replaced Radarr/Sonarr on 2026-07-24. It owns the indexers (it talks
# to Prowlarr itself), the quality profiles, the scoring rules and the download
# clients — the bot is only a GraphQL client and must NOT be given Prowlarr
# credentials of its own.
# ---------------------------------------------------------------------------
SCRYER_URL=http://scryer:8088
SCRYER_USERNAME=admin
SCRYER_PASSWORD=your_scryer_password
# Release searches fan out to every routed indexer — they are slower than a
# plain API call, hence a separate timeout.
# SCRYER_SEARCH_TIMEOUT=90.0

# ---------------------------------------------------------------------------
# Music
# ---------------------------------------------------------------------------
# Lidarr (optional) — artist/album monitoring; hands downloads to slskd.
# LIDARR_URL=http://lidarr:8686
# LIDARR_API_KEY=your_lidarr_api_key

# slskd / Soulseek (optional) — direct album & track search, and the download
# client Lidarr itself uses. Enables /music album+track search without Lidarr.
# SLSKD_URL=http://slskd:5030
# SLSKD_API_KEY=your_slskd_api_key
# SLSKD_TIMEOUT=30.0
# SLSKD_SEARCH_TIMEOUT=25.0   # how long to gather Soulseek responses

# Navidrome (optional) — read-only "already in the library" check so the bot
# doesn't queue duplicates. All three values are required to enable it.
# NAVIDROME_URL=http://navidrome:4533
# NAVIDROME_USERNAME=your_navidrome_user
# NAVIDROME_PASSWORD=your_navidrome_password
# NAVIDROME_TIMEOUT=15.0

# Deezer public API (for music trending, no key required)
# DEEZER_ENABLED=true

# ---------------------------------------------------------------------------
# Download client & media server
# ---------------------------------------------------------------------------
# qBittorrent (optional) — download status, plus the "force download" escape
# hatch for a release Scryer's quality profile blocks.
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=your_qbittorrent_password
# QBITTORRENT_TIMEOUT=30.0

# Emby (optional) — "already in library" hint on release cards
EMBY_URL=http://emby:8096
EMBY_API_KEY=your_emby_api_key
# EMBY_TIMEOUT=30.0

# TMDb Configuration (optional, for trending/popular content)
# Get your API key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key
# TMDB_LANGUAGE=ru-RU  # Language for TMDb content (ru-RU, en-US, etc.)
# TMDB_PROXY_URL=http://your-vps:8899  # HTTP proxy for TMDb (if geo-blocked)

# Download Notifications
NOTIFY_DOWNLOAD_COMPLETE=true
NOTIFY_CHECK_INTERVAL=60
# Send admins a "bot is up" card on startup (which backends answered, versions)
# NOTIFY_ADMINS_ON_START=true

# Optional Settings
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
# LOG_FORMAT=json  # "json" for docker logs (default) or "console" for local dev

# Database path (relative to /app in container)
DATABASE_PATH=data/bot.db

# Scoring thresholds
AUTO_GRAB_SCORE_THRESHOLD=80

# HTTP client settings
# HTTP_TIMEOUT=30.0  # HTTP request timeout in seconds

# Pagination
# RESULTS_PER_PAGE=5  # Search results per page (1-10)

# Webhook server (optional, #8) — instant "added to library" notifications.
# Payload format is the *arr webhook schema; Scryer's own notification channels
# are configured on the Scryer side and are not wired to this endpoint yet.
# WEBHOOK_ENABLED=false
# WEBHOOK_PORT=8090
# WEBHOOK_BIND=127.0.0.1
# WEBHOOK_TOKEN=  # required shared secret when WEBHOOK_ENABLED=true
